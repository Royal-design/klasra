# Copy this file to .env and fill in your local values.
# Never commit .env to version control.

APP_NAME=School LMS API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Use a dedicated least-privilege PostgreSQL user (not the postgres superuser in production).
# Example: postgresql+psycopg://lms_user:your_password@127.0.0.1:5432/lms_db
DATABASE_URL=postgresql+psycopg://lms_user:CHANGE_ME@127.0.0.1:5432/lms_db

# Comma-separated list of trusted frontend origins (never use *).
CORS_ORIGINS=http://localhost:3000
