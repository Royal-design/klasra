# Copy this file to .env and fill in your local values.
# Never commit .env to version control.

APP_NAME=School LMS API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Use a dedicated least-privilege PostgreSQL user (not the postgres superuser in production).
# Example: postgresql+psycopg://lms_user:your_password@127.0.0.1:5432/lms_db
DATABASE_URL=postgresql+psycopg://lms_user:CHANGE_ME@127.0.0.1:5432/lms_db

# Comma-separated list of trusted frontend origins (never use *).
CORS_ORIGINS=http://localhost:3000

# Session & cookie settings
SESSION_TTL_HOURS=12
# Set COOKIE_SECURE=true in staging/production (HTTPS). Use false only for local HTTP dev.
COOKIE_SECURE=false

# Rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=15

# Email provider (console for local dev/tests; resend for staging/production)
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_...
# EMAIL_FROM=no-reply@yourdomain.com
# FRONTEND_BASE_URL=http://localhost:3000

# Secure file storage (local for dev/tests; s3 for Cloudflare R2 / Backblaze B2 / AWS S3 / Supabase)
STORAGE_PROVIDER=local
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=school-lms-files
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

